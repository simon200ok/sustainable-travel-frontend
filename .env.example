# Copy to .env for local development. Everything starting with VITE_ is PUBLIC
# (built into the JavaScript), so never put secret keys here.
VITE_API_BASE_URL=http://localhost:8000

# Google Maps *browser* key: Maps JavaScript API only, restricted to your site's
# web addresses (HTTP referrers). Different key from the backend's server key.
VITE_GOOGLE_MAPS_BROWSER_KEY=

# Map ID from Google Cloud → Google Maps Platform → Map Management (free).
VITE_GOOGLE_MAP_ID=
